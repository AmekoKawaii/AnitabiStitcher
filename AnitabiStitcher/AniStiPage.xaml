<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AnitabiStitcher.AniStiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AnitabiStitcher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="160"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--<TextBox x:Name="Occupy1"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            PlaceholderText="Enter your note"
            Header="New note"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            Height="200"
            Width="600"
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="3"/>-->
        <Border x:Name="ImagePreviewBorder"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="2"
                Height="200"
                Width="600"
                Grid.Row="1"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                >
            <StackPanel x:Name="ImageContainer"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"/>
        </Border>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Spacing="4"
                    Grid.Row="2" Grid.Column="3">
            <Button Content="清除" Click="DeleteImages_Click"/>
            <Button Content="浏览" Click="BrowseImages_Click"/>
        </StackPanel>

        <TextBox x:Name="TotalWidth"
                 Header="总宽度"
                 PlaceholderText="2160"
                 Grid.Row="3"
                 Grid.Column="1"
                 Width="100"
                 Height="60"
                 TextWrapping="NoWrap"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="0,0,0,0"
                 BeforeTextChanging="NumberBox_BeforeTextChanging"
                 LostFocus="IntegerInput_LostFocus"/>
        
        <TextBox x:Name="EdgeMargin"
                 Header="边距"
                 PlaceholderText="90"
                 Grid.Row="3"
                 Grid.Column="2"
                 Width="100"
                 Height="60"
                 TextWrapping="NoWrap"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="0,0,0,0"
                 BeforeTextChanging="NumberBox_BeforeTextChanging"
                 LostFocus="IntegerInput_LostFocus"/>
        
        <TextBox x:Name="Space"
                 Header="图片间距"
                 PlaceholderText="90"
                 Grid.Row="3"
                 Grid.Column="3"
                 Width="100"
                 Height="60"
                 TextWrapping="NoWrap"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,0,0,0"
                 BeforeTextChanging="NumberBox_BeforeTextChanging"
                 LostFocus="IntegerInput_LostFocus"/>

        <TextBox x:Name="Discription"
                 VerticalAlignment="Top"
                 Margin="0,10,0,0"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 PlaceholderText="在这里输入图片描述"
                 Header="图片描述"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Height="150"
                 Width="600"
                 Grid.Row="4"
                 Grid.Column="1"
                 Grid.ColumnSpan="3"/>

        <Button Content="合成"
                Grid.Row="5"
                Grid.Column="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="StartStitching_Click"/>

        <Button Content="选项"
        Grid.Row="5"
        Grid.Column="1"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Click="OnSettingsButtonClick"/>

        <ContentDialog
    x:Name="SettingsDialog"
    Title="设置"
    PrimaryButtonText="确定"
    SecondaryButtonText="取消"
    DefaultButton="Primary"
    Width="400"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

            <StackPanel Spacing="12">
                <TextBlock Text="字体大小"/>
                <Slider x:Name="FontSizeSlider" Minimum="6" Maximum="72" Value="40"/>

                <TextBlock Text="字体路径"/>
                <TextBox x:Name="FontPathTextBox" PlaceholderText="例如：C:\Windows\Fonts\xx.ttf"/>

                <TextBlock Text="输出路径"/>
                <TextBox x:Name="OutPathTextBox" PlaceholderText="例如：C:\Users\9EI\Desktop\output"/>
                <!-- 其他设置控件... -->
            </StackPanel>
        </ContentDialog>

    </Grid>
    
    
</Page>
